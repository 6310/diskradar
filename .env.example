# Geio DiskRadar - Exemplo de Variáveis de Ambiente
# Copie para .env caso deseje customizar configurações em ambiente de desenvolvimento

# Nível de log (DEBUG, INFO, WARNING, ERROR)
DISKRADAR_LOG_LEVEL=INFO

# Diretório padrão para exportação de relatórios HTML (deixe vazio para usar a pasta do usuário)
DISKRADAR_DEFAULT_EXPORT_DIR=

# Caminho opcional para unidade de testes simulada no Linux/Windows
DISKRADAR_TEST_MOUNT_PATH=
